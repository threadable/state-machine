{
  "name": "threadable/state-machine",
  "description": "State Machine for Laravel by Threadable",
  "keywords": [
    "threadable"
  ],
  "homepage": "https://threadable.io/",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Padraig Nolan",
      "email": "padraig@threadable.io"
    },
    {
      "name": "Tomasz Mroziński",
      "email": "tomasz@threadable.io"
    }
  ],
  "require": {
    "php": ">=8.3",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/events": "^11.0|^12.0|^13.0",
    "illuminate/filesystem": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/validation": "^11.0|^12.0|^13.0",
    "nesbot/carbon": "^2.67|^3.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.1",
    "laravel/pint": "^1.21"
  },
  "autoload": {
    "psr-4": {
      "Threadable\\StateMachine\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\": "tests/Fixtures/App/",
      "Domain\\": "tests/Fixtures/Domain/",
      "Threadable\\StateMachine\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "format": "vendor/bin/pint",
    "lint": "vendor/bin/pint --test",
    "analyse": "php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress --debug",
    "test": "phpunit",
    "ci": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Threadable\\StateMachine\\Providers\\ThreadstateServiceProvider"
      ]
    }
  }
}
